parameters:
	ignoreErrors:
		-
			message: '#^Offset ''title'' on array\{title\: string, text\: string, url\: string\|null, date\: DateTimeImmutable\|null\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Service/DigestDrafter.php

		-
			message: '#^Call to function method_exists\(\) with Symfony\\Bridge\\Twig\\Mime\\TemplatedEmail and ''locale'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Service/NewsletterMailer.php
